Options -MultiViews
DirectoryIndex index.html

# MIME Types
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType image/jpeg .jpg .jpeg .JPG .JPEG
  AddType image/png .png .PNG
  AddType image/svg+xml .svg .SVG
  AddType application/pdf .pdf
  AddType image/webp .webp
</IfModule>

# ============================================================
# CACHE CONTROL
# index.html TIDAK boleh di-cache agar update langsung terasa
# ============================================================
<IfModule mod_headers.c>
  # index.html: selalu ambil dari server (no-cache)
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # File JS & CSS: boleh di-cache lama (karena nama berubah tiap build)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Gambar: cache 30 hari
  <FilesMatch "\.(jpg|jpeg|png|svg|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# SPA Fallback: semua request yang bukan file/folder diarahkan ke index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [QSA,L]
</IfModule>

# Error handling: redirect 404 ke index.html supaya React Router bisa tangani
ErrorDocument 404 /index.html
